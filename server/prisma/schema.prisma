// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // Add this line
}

datasource db {
  provider = "postgresql"
}

// =======================
// ENUMS & CONSTANTS
// =======================

enum Role {
  LEAD_DEV
  COORDINATOR
  DONOR
  RECEIVER
  DELIVERY_MAN
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL      // Urgency 9+
}

enum RequestStatus {
  OPEN          // Actively seeking donations
  PARTIAL       // Partially fulfilled, still needs more
  FULFILLED     // Completely matched with pledges
}

enum DeliveryStatus {
  LOCKED        // Transaction locked, waiting for pickup
  IN_TRANSIT    // Picked up by delivery man
  COMPLETED     // Receiver confirmed receipt
  FAILED        // Delivery failed (e.g. damaged/missing)
}

enum ApplicationStatus {
  NEW
  VIEWED        // Coordinator opened it but didn't decide yet
  APPROVED
  REJECTED
}

// =======================
// USER & AUTHENTICATION
// =======================

model User {
  id              String    @id @default(uuid())
  email           String    @unique // Sanitized: lowercase
  passwordHash    String
  role            Role
  
  // Profile Info
  name            String    // Sanitized: Title Case
  organization    String?   // Nullable
  phone           String
  address         String
  city            String
  website         String?
  avatar          String?   // URL to image
  
  // Gamification & Stats
  badges          String[]  // ["BRONZE", "SILVER"]
  totalWeight     Float     @default(0) // kg
  totalVolume     Float     @default(0) // liters
  totalUnits      Int       @default(0) // pieces
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  inventory       SurplusInventory[]
  sentMessages    Message[]          @relation("Sender")
  receivedMessages Message[]         @relation("Receiver")
  
  // Role specific relations
  foodRequests    FoodRequest[]      // Receiver: Created requests
  logbooks        Logbook[]          // Receiver: Daily logs
  
  // Logistics Relations (Unified into Pledges)
  donorPledges    Pledge[]           @relation("DonorPledges")
  driverPledges   Pledge[]           @relation("DriverPledges")
}

model Application {
  id              String            @id @default(uuid())
  role            Role
  name            String
  organization    String?
  email           String            // Sanitized: lowercase
  phone           String
  address         String
  city            String
  motivation      String            // "Why join"
  status          ApplicationStatus @default(NEW)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// =======================
// INVENTORY & CATEGORIES
// =======================

model FoodCategory {
  id              Int               @id @default(autoincrement()) 
  name            String            @unique // "Chicken", "Rice"
  unit            String            // "kg", "liter", "pieces"
  
  inventoryItems  SurplusInventory[]
  requestItems    RequestItem[]
  pledgeItems     PledgeItem[]      // Inverse relation fixed
}

model SurplusInventory {
  id              String        @id @default(uuid())
  donorId         String
  donor           User          @relation(fields: [donorId], references: [id])
  
  categoryId      Int
  category        FoodCategory  @relation(fields: [categoryId], references: [id])
  
  description     String        // "Fried Chicken", "Basmati Rice"
  currentQuantity Float
  batchNumber     String        // Sanitized: B001
  expiryDate      DateTime
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Note: No direct link to Pledges/Allocations here to prevent Cascade Delete data loss.
}

// =======================
// REQUESTS & LOGISTICS
// =======================

model FoodRequest {
  id             String        @id @default(uuid())
  receiverId     String
  receiver       User          @relation(fields: [receiverId], references: [id])
  
  orgName        String
  location       String
  urgency        String        // Will now store '1', '2', or '3'
  requiredWithin String?       // Format: "hr:min" (e.g., "02:30")
  description    String?       // Short text area
  status         RequestStatus @default(OPEN) 
  
  items          RequestItem[]
  pledges        Pledge[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model RequestItem {
  id              String       @id @default(uuid())
  requestId       String
  request         FoodRequest  @relation(fields: [requestId], references: [id])
  categoryId      Int
  category        FoodCategory @relation(fields: [categoryId], references: [id])
  
  initialQuantity Float        @default(0)  // <-- THIS MUST BE HERE
  deficit         Float
}

// The Unified Transaction Model (Replaces Allocation & Delivery)
model Pledge {
  id              String         @id @default(uuid())
  
  requestId       String
  request         FoodRequest    @relation(fields: [requestId], references: [id])
  
  donorId         String
  donor           User           @relation("DonorPledges", fields: [donorId], references: [id])
  
  driverId        String
  driver          User           @relation("DriverPledges", fields: [driverId], references: [id])
  
  // Unified Delivery Tracking
  status          DeliveryStatus @default(LOCKED)
  pickupAddress   String?        
  dropAddress     String?        
  pickupTime      DateTime?
  deliveredTime   DateTime?
  
  items           PledgeItem[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // STRICT RULE: A donor can only have one active pledge per specific request
  @@unique([requestId, donorId]) 
}

model PledgeItem {
  id          String        @id @default(uuid())
  pledgeId    String
  pledge      Pledge        @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  
  categoryId  Int           // Fixed: Was String, now matches FoodCategory.id
  category    FoodCategory  @relation(fields: [categoryId], references: [id])
  
  quantity    Float
}

// =======================
// LOGBOOK & MESSAGING
// =======================

model Logbook {
  id               String    @id @default(uuid())
  receiverId       String
  receiver         User      @relation(fields: [receiverId], references: [id])
  
  date             DateTime  @default(now()) // Only one per day per user
  
  lunchEstimated   Int       // Step 1
  dinnerEstimated  Int?      // Step 2 (Locked until lunch complete)
  
  lunchServed      Int?
  dinnerServed     Int?
  
  isLunchComplete  Boolean   @default(false)
  isDinnerComplete Boolean   @default(false)
  
  // Shortage Calculation
  dailyShortage    Int       @default(0)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("Sender", fields: [senderId], references: [id])
  
  receiverId  String
  receiver    User      @relation("Receiver", fields: [receiverId], references: [id])
  
  content     String
  isRead      Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}