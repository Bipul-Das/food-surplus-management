# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# Keep environment variables out of version control
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==========================================
# PRISMA ORM
# ==========================================
# Ignore custom generated Prisma client outputs
/src/generated/prisma
/server/src/generated/prisma
*.db
*.db-journal
*.sqlite

# ==========================================
# NEXT.JS (CLIENT BUILD OUTPUTS)
# ==========================================
.next/
out/
client/build/
client/dist/
.contentlayer/

# ==========================================
# EXPRESS / NODE.JS (SERVER BUILD OUTPUTS)
# ==========================================
server/dist/
server/build/

# ==========================================
# TYPESCRIPT
# ==========================================
*.tsbuildinfo

# ==========================================
# LOGS & DIAGNOSTICS
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# TESTING & COVERAGE
# ==========================================
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# ==========================================
# OS & EDITOR CONFIGURATIONS
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ==========================================
